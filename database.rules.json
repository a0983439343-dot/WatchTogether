{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() == auth.uid) || (data.exists() && newData.child('owner').val() == data.child('owner').val()))",
        "owner": { ".validate": "newData.isString() && (data.exists() ? newData.val() == data.val() : newData.val() == auth.uid)" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "sourceType": { ".validate": "newData.isString() && (newData.val() == 'youtube' || newData.val() == 'direct')" },
        "sourceUrl": { ".validate": "newData.isString() && newData.val().length <= 2048" },
        "state": {
          ".write": "auth != null && data.parent().exists()",
          ".validate": "newData.hasChildren(['action','position','updatedAt','updatedBy'])",
          "action": { ".validate": "newData.isString() && (newData.val() == 'play' || newData.val() == 'pause' || newData.val() == 'seek' || newData.val() == 'sync')" },
          "position": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "updatedBy": { ".validate": "newData.val() == auth.uid" }
        },
        "chat": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
            ".validate": "newData.hasChildren(['uid','name','text','createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        }
      }
    },
    "members": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name','joinedAt'])"
        }
      }
    }
  }
}
