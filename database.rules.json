{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        "owner": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "name": {
          ".write": "auth != null && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "sourceType": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
        },
        "sourceUrl": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "video": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'platform', 'title', 'thumbnail', 'channel']) && newData.child('id').isString() && newData.child('platform').isString() && newData.child('title').isString() && newData.child('thumbnail').isString() && newData.child('channel').isString())",
          "id": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "url": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
          },
          "platform": {
            ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "thumbnail": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "channel": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "twitchType": {
            ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'channel' || newData.val() === 'video' || newData.val() === 'clip'))"
          }
        },
        "state": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['action', 'position', 'playing', 'updatedAt', 'updatedBy'])",
          "action": {
            ".validate": "newData.isString() && (newData.val() === 'play' || newData.val() === 'pause' || newData.val() === 'seek' || newData.val() === 'sync')"
          },
          "position": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "playing": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 60000"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },
        "queue": {
          "$queueId": {
            ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists() && ((!data.exists()) || (newData.exists() && (data.child('addedBy').val() === auth.uid || root.child('rooms').child($roomId).child('owner').val() === auth.uid)) || (!newData.exists() && (data.child('addedBy').val() === auth.uid || root.child('rooms').child($roomId).child('owner').val() === auth.uid)))",
            ".validate": "!newData.exists() || (newData.hasChildren(['id','platform','title','thumbnail','channel','addedBy','addedByName','addedAt']) && newData.child('addedBy').isString() && newData.child('addedBy').val() === (data.exists() ? data.child('addedBy').val() : auth.uid))",
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "platform": {
              ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "thumbnail": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "channel": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "addedBy": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "addedByName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "addedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000"
            }
          }
        },
        "chat": {
          "$messageId": {
            ".read": "auth != null",
            ".write": "auth != null && !data.exists() && root.child('members').child($roomId).child(auth.uid).exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000"
            }
          }
        }
      }
    },
    "members": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).exists() && (auth.uid === $uid || (!newData.exists() && auth.uid === root.child('rooms').child($roomId).child('owner').val()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('joinedAt').isNumber())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },
          "joinedAt": {
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() <= now + 10000)"
          },
          "online": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "lastSeen": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        }
      }
    }
  }
}
