{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "owner": {
          ".validate": "newData.isString()"
        },

        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },

        "sourceType": {
          ".validate": "newData.isString()"
        },

        "sourceUrl": {
          ".validate": "newData.isString()"
        },

        "state": {
          ".validate": "newData.hasChildren(['action', 'position', 'playing', 'updatedAt', 'updatedBy'])",

          "position": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },

          "playing": {
            ".validate": "newData.isBoolean()"
          },

          "updatedBy": {
            ".validate": "newData.isString()"
          }
        },

        "chat": {
          "$messageId": {
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",

            "text": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },

            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },

            "uid": {
              ".validate": "newData.isString()"
            }
          }
        }
      }
    },

    "members": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null",

          ".write": "auth != null && auth.uid === $uid",

          ".validate": "newData.hasChildren(['name', 'joinedAt'])",

          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },

          "joinedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
