{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",

        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('owner').val() === auth.uid",

        "owner": {
          ".validate": "newData.isString() && newData.val() === (data.exists() ? data.val() : auth.uid)"
        },

        "name": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },

        "sourceType": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
        },

        "sourceUrl": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },

        "video": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",

          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'platform', 'title', 'thumbnail', 'channel']) && newData.child('id').isString() && newData.child('platform').isString() && newData.child('title').isString() && newData.child('thumbnail').isString() && newData.child('channel').isString())",

          "id": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },

          "url": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
          },

          "platform": {
            ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
          },

          "title": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },

          "thumbnail": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },

          "channel": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },

          "twitchType": {
            ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'channel' || newData.val() === 'video' || newData.val() === 'clip'))"
          }
        },

        "state": {
          ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",

          ".validate": "newData.hasChildren(['action', 'position', 'playing', 'updatedAt', 'updatedBy'])",

          "action": {
            ".validate": "newData.isString() && (newData.val() === 'play' || newData.val() === 'pause' || newData.val() === 'seek' || newData.val() === 'sync')"
          },

          "position": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },

          "playing": {
            ".validate": "newData.isBoolean()"
          },

          "updatedAt": {
            ".validate": "newData.isNumber()"
          },

          "updatedBy": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },

        "queue": {
          ".read": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",

          "$queueId": {
            ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",

            ".validate": "!newData.exists() || newData.hasChildren(['id', 'platform', 'title', 'thumbnail', 'channel', 'addedBy', 'addedByName', 'addedAt'])",

            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },

            "platform": {
              ".validate": "newData.isString() && (newData.val() === 'youtube' || newData.val() === 'vimeo' || newData.val() === 'dailymotion' || newData.val() === 'bilibili' || newData.val() === 'twitch' || newData.val() === 'netflix' || newData.val() === 'crunchyroll' || newData.val() === 'disneyplus' || newData.val() === 'primevideo' || newData.val() === 'appletv' || newData.val() === 'max' || newData.val() === 'hulu' || newData.val() === 'paramount' || newData.val() === 'peacock')"
            },

            "title": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },

            "thumbnail": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },

            "channel": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },

            "addedBy": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },

            "addedByName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },

            "addedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        },

        "chat": {
          ".read": "auth != null && root.child('members').child($roomId).child(auth.uid).exists()",

          "$messageId": {
            ".write": "auth != null && root.child('members').child($roomId).child(auth.uid).exists() && (!data.exists() && newData.child('uid').val() === auth.uid)",

            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },

            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },

            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },

            "createdAt": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },

    "members": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).exists()",

        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).exists()",

          ".validate": "!newData.exists() || (newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('joinedAt').isNumber())",

          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },

          "joinedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
